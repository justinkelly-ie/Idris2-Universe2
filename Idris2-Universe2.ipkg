package Idris2-Universe2
version = 0.2.0
authors = "Justin Kelly"

-- Zero external library dependencies: pure bootstrapping via base and Language.Reflection
depends = base

sourcedir = "src"

modules = Core.BoxInt,
          Core.Multiset,
          Core.Polynumber,
          Core.Polynomial,
          Core.VexelMaxel,
          Core.SingFraction,
          Core.OnSeq,
          Core.MultisetTree,
          Geometry.LatticeTopology,
          Geometry.GrassmannCalculus,
          Geometry.InformationGeometry,
          Math.Infinitesimal,
          Math.QuantumTransition,
          Math.WilsonPolyhedra,
          Math.FourGeometries,
          Math.DiscreteActionPrinciple,
          Math.DiscreteBoltzmannDistribution,
          Math.DiscreteCasimirEffect,
          Math.TopologicalChernNumber,
          Math.AharonovBohmHolonomy,
          Math.DiscreteLandauerPrinciple,
          Math.DiscretePoyntingTheorem,
          Math.DiscreteDiracSpinor,
          Math.PauliExclusion,
          Math.GravitationalWaveDynamics,
          Math.SuperconductingFluxQuantization,
          Math.ConstructiveBaryogenesis,
          Math.RenormalizationInformationFlow,
          Math.RGDecimator,
          Math.GaugeSpinorCoupling,
          Math.ToroidalAstrodynamics,
          Math.GalacticRotationCurve,
          Math.ShannonHuffmanOptimality,
          Math.HelmholtzFreeEnergy,
          Math.RationalTrig,
          Math.FineStructure,
          Math.LinAlgebra.MetricTensor,
          Math.LinAlgebra.TernaryClassifier,
          Math.LinAlgebra.BilinearProduct,
          Compound.HadronicConfinement,
          Compound.PlasmaRecombination,
          Compound.AlphaReplication,
          Compound.StellarNucleosynthesis,
          Compound.MolecularBonding,
          Compound.HydrogenBonding,
          Compound.WatsonCrickBasePairing,
          Compound.MacromolecularChirality,
          Evolution.State,
          Evolution.Init,
          Evolution.Expansion,
          Evolution.Contraction,
          Evolution.Bootstrap,
          Evolution.LinearPipeline,
          Evolution.StructuralAccounting,
          Derivation.PureGeometricClassifier,
          Compound.LinearEpsilonRouting,
          Compound.VelocityLensing,
          Compound.SymplecticIntegrator,
          Math.CliffordAlgebra,
          Reflect.PermutationSolver,
          Reflect.InvariantAuditor
